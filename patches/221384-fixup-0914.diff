   // complex.sub(a, complex.constant<0.0, 0.0>) -> a
@@ -322,11 +328,16 @@ OpFoldResult NegOp::fold(FoldAdaptor adaptor) {
 
 OpFoldResult ExpOp::fold(FoldAdaptor adaptor) {
   // complex.exp(complex.log(a)) -> a
